{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Onboarding cliente de coach — Influence Fit",
  "description": "Estructura del JSON que produce el formulario de onboarding. El orden de 'columnas' es el orden de las columnas en Google Sheets / Airtable.",
  "columnas": [
    "fecha", "coach", "nombre", "edad", "sexo", "whatsapp", "email", "comuna",
    "altura_cm", "peso_kg",
    "objetivo", "objetivo_detalle", "plazo",
    "experiencia_nivel", "experiencia_anios", "entreno_actual",
    "lesiones_zonas", "lesiones_detalle", "condiciones_medicas", "medicamentos", "cirugias",
    "dias_semana", "minutos_sesion", "horario", "modalidad",
    "equipamiento", "equipamiento_detalle",
    "gustan", "no_gustan", "sueno_horas", "estres", "nutricion",
    "como_llego", "consentimiento", "origen", "version"
  ],
  "type": "object",
  "required": ["coach", "nombre", "whatsapp", "objetivo", "experiencia_nivel", "dias_semana", "minutos_sesion", "equipamiento", "consentimiento"],
  "properties": {
    "fecha": { "type": "string", "format": "date-time" },
    "coach": { "type": "string", "description": "Identificador del coach dueño del formulario (viene del parámetro ?coach=)" },
    "nombre": { "type": "string" },
    "edad": { "type": "integer", "minimum": 14, "maximum": 99 },
    "sexo": { "type": "string", "enum": ["Femenino", "Masculino", "Otro", "Prefiero no decir"] },
    "whatsapp": { "type": "string", "pattern": "^569[0-9]{8}$" },
    "email": { "type": "string" },
    "comuna": { "type": "string" },
    "altura_cm": { "type": "integer" },
    "peso_kg": { "type": "number" },
    "objetivo": { "type": "string", "enum": ["Ganar masa muscular", "Perder grasa", "Fuerza", "Rendimiento deportivo", "Salud general / movilidad", "Rehabilitación / volver a entrenar", "Preparar una competencia"] },
    "objetivo_detalle": { "type": "string" },
    "plazo": { "type": "string" },
    "experiencia_nivel": { "type": "string", "enum": ["Nunca he entrenado", "Principiante (menos de 1 año)", "Intermedio (1 a 3 años)", "Avanzado (más de 3 años)"] },
    "experiencia_anios": { "type": "number" },
    "entreno_actual": { "type": "string" },
    "lesiones_zonas": { "type": "array", "items": { "type": "string" } },
    "lesiones_detalle": { "type": "string" },
    "condiciones_medicas": { "type": "string" },
    "medicamentos": { "type": "string" },
    "cirugias": { "type": "string" },
    "dias_semana": { "type": "integer", "minimum": 1, "maximum": 7 },
    "minutos_sesion": { "type": "integer" },
    "horario": { "type": "string" },
    "modalidad": { "type": "string", "enum": ["Presencial", "Online", "Mixto"] },
    "equipamiento": { "type": "string", "enum": ["Gimnasio completo", "Casa con equipamiento básico", "Solo peso corporal", "Box / funcional"] },
    "equipamiento_detalle": { "type": "string" },
    "gustan": { "type": "string" },
    "no_gustan": { "type": "string" },
    "sueno_horas": { "type": "string" },
    "estres": { "type": "string" },
    "nutricion": { "type": "string" },
    "como_llego": { "type": "string" },
    "consentimiento": { "type": "boolean" },
    "origen": { "type": "string" },
    "version": { "type": "string" }
  }
}
